pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
p={
  x=64,
  y=64,
  }
end

function _update()
if btn(➡️) then p.x=p.x+1 end
if btn(⬅️) then p.x=p.x-1 end
end

function _draw()
cls()
print("hello world")
spr(1,p.x,p.y)
end
